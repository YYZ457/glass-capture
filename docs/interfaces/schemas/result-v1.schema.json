{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SG3000 processing result v1 (after stripping SGJSON prefix)",
  "type": "object",
  "required": ["schema","event","source","processor","sequence","received_line_start","received_ns","block_id","width","height","stride","flags","processed_total","decision","algorithm","pixel_count","sum","above_threshold","min","max","continuity_verified"],
  "properties": {
    "schema":{"const":1}, "event":{"const":"result"},
    "source":{"enum":["hardware","synthetic"]},"processor":{"enum":["stats","pl"]},
    "sequence":{"$ref":"#/$defs/u64"},"received_line_start":{"$ref":"#/$defs/u64"},
    "received_ns":{"$ref":"#/$defs/u64"},"processed_total":{"$ref":"#/$defs/u64"},
    "pixel_count":{"$ref":"#/$defs/u64"},"sum":{"$ref":"#/$defs/u64"},"above_threshold":{"$ref":"#/$defs/u64"},
    "block_id":{"type":"integer","minimum":0,"maximum":4294967295},
    "width":{"type":"integer","minimum":1},"height":{"type":"integer","minimum":1},"stride":{"type":"integer","minimum":1},
    "flags":{"type":"integer","minimum":0},"algorithm":{"type":"integer","minimum":0},
    "decision":{"enum":["unknown","pass","fail"]},"min":{"type":"integer","minimum":0,"maximum":255},"max":{"type":"integer","minimum":0,"maximum":255},
    "continuity_verified":{"const":false}
  },
  "additionalProperties":false,
  "$defs":{"u64":{"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"}}
}
