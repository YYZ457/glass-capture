{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sg3000:frame-candidates-v1",
  "title": "Uploaded P5 native candidate page; no hardware or accuracy claim",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "run", "pagination", "components"],
  "properties": {
    "schema_version": {"const": "frame-candidates-v1"},
    "run": {"$ref": "#/$defs/run"},
    "pagination": {
      "type": "object", "additionalProperties": false,
      "required": ["offset", "limit", "total", "returned", "has_more"],
      "properties": {
        "offset": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "limit": {"type": "integer", "minimum": 1, "maximum": 1000},
        "total": {"type": "integer", "minimum": 0, "maximum": 8388608},
        "returned": {"type": "integer", "minimum": 0, "maximum": 1000},
        "has_more": {"type": "boolean"}
      }
    },
    "components": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/component"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "options": {
      "type": "object", "additionalProperties": false,
      "required": ["input_id", "radius", "threshold", "polarity"],
      "properties": {
        "input_id": {"type": "string", "pattern": "^input-[0-9a-f]{32}$"},
        "radius": {"type": "integer", "minimum": 0, "maximum": 7},
        "threshold": {"type": "integer", "minimum": 1, "maximum": 255},
        "polarity": {"enum": ["both", "bright", "dark"]}
      }
    },
    "image": {
      "type": "object", "additionalProperties": false,
      "required": ["source_width", "source_height", "preview_width", "preview_height", "downsample_step"],
      "properties": {
        "source_width": {"type": "integer", "minimum": 1, "maximum": 16384},
        "source_height": {"type": "integer", "minimum": 1, "maximum": 65536},
        "preview_width": {"type": "integer", "minimum": 1, "maximum": 2048},
        "preview_height": {"type": "integer", "minimum": 1, "maximum": 1024},
        "downsample_step": {"type": "integer", "minimum": 1, "maximum": 64}
      }
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "created_at", "finished_at", "options", "input_id", "input_sha256", "display_name", "source", "provenance", "decision", "board_tested", "accuracy_evaluated", "width", "height", "radius", "threshold", "polarity", "component_count", "bbox_convention", "connectivity", "implementation", "min_area", "images", "native_wall_seconds", "stripes", "retained_input_cache_peak_bytes", "output_words_sha256", "output_sha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^frame-[0-9a-f]{32}$"},
        "status": {"const": "complete"},
        "created_at": {"type": "number", "minimum": 0},
        "finished_at": {"type": "number", "minimum": 0},
        "options": {"$ref": "#/$defs/options"},
        "input_id": {"type": "string", "pattern": "^input-[0-9a-f]{32}$"},
        "input_sha256": {"$ref": "#/$defs/hash"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 256},
        "source": {"const": "uploaded-pgm"},
        "provenance": {"const": "file-native"},
        "decision": {"const": "unknown"},
        "board_tested": {"const": false},
        "accuracy_evaluated": {"const": false},
        "width": {"type": "integer", "minimum": 1, "maximum": 16384},
        "height": {"type": "integer", "minimum": 1, "maximum": 65536},
        "radius": {"type": "integer", "minimum": 0, "maximum": 7},
        "threshold": {"type": "integer", "minimum": 1, "maximum": 255},
        "polarity": {"enum": ["both", "bright", "dark"]},
        "component_count": {"type": "integer", "minimum": 0, "maximum": 8388608},
        "bbox_convention": {"const": "half-open"},
        "connectivity": {"const": 8},
        "implementation": {"const": "native C++ shared with FPGA IP"},
        "min_area": {"const": 2},
        "images": {
          "type": "object", "additionalProperties": false,
          "required": ["source", "corrected", "mask"],
          "properties": {
            "source": {"$ref": "#/$defs/image"},
            "corrected": {"$ref": "#/$defs/image"},
            "mask": {"$ref": "#/$defs/image"}
          }
        },
        "native_wall_seconds": {"type": "number", "minimum": 0},
        "stripes": {"type": "integer", "minimum": 1, "maximum": 65536},
        "retained_input_cache_peak_bytes": {"type": "integer", "minimum": 0, "maximum": 8388608},
        "output_words_sha256": {"$ref": "#/$defs/hash"},
        "output_sha256": {
          "type": "object", "additionalProperties": false,
          "required": ["run.json", "corrected.pgm", "mask.pgm", "components.jsonl"],
          "properties": {
            "run.json": {"$ref": "#/$defs/hash"},
            "corrected.pgm": {"$ref": "#/$defs/hash"},
            "mask.pgm": {"$ref": "#/$defs/hash"},
            "components.jsonl": {"$ref": "#/$defs/hash"}
          }
        }
      }
    },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "bbox", "polarity", "area", "peak", "signed_peak", "frame_id", "decision"],
      "properties": {
        "id": {"type": "string", "pattern": "^c[0-9]{6,}$"},
        "bbox": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "prefixItems": [
            {"type": "integer", "minimum": 0, "maximum": 16383},
            {"type": "integer", "minimum": 0, "maximum": 65535},
            {"type": "integer", "minimum": 1, "maximum": 16384},
            {"type": "integer", "minimum": 1, "maximum": 65536}
          ]
        },
        "polarity": {"enum": ["bright", "dark"]},
        "area": {"type": "integer", "minimum": 2, "maximum": 8388608},
        "peak": {"type": "integer", "minimum": 1, "maximum": 255},
        "signed_peak": {"type": "integer", "minimum": -255, "maximum": 255, "not": {"const": 0}},
        "frame_id": {"const": 0},
        "decision": {"const": "unknown"}
      }
    }
  }
}
