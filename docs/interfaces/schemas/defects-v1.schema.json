{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sg3000:defects-v1",
  "title": "SG3000 offline defect candidate page",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run", "pagination", "components"],
  "properties": {
    "schema_version": {"const": "defects-v1"},
    "run": {"$ref": "#/$defs/run"},
    "pagination": {
      "type": "object", "additionalProperties": false,
      "required": ["offset", "limit", "total", "returned", "has_more"],
      "properties": {
        "offset": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "limit": {"type": "integer", "minimum": 1, "maximum": 1000},
        "total": {"type": "integer", "minimum": 0},
        "returned": {"type": "integer", "minimum": 0, "maximum": 1000},
        "has_more": {"type": "boolean"}
      }
    },
    "components": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/component"}}
  },
  "$defs": {
    "options": {
      "type": "object", "additionalProperties": false, "required": ["radius", "threshold", "polarity"],
      "properties": {
        "radius": {"type": "integer", "minimum": 0, "maximum": 7},
        "threshold": {"type": "integer", "minimum": 1, "maximum": 255},
        "polarity": {"enum": ["both", "bright", "dark"]}
      }
    },
    "image": {
      "type": "object", "additionalProperties": false,
      "required": ["source_width", "source_height", "preview_width", "preview_height"],
      "properties": {
        "source_width": {"const": 16384}, "source_height": {"const": 135},
        "preview_width": {"const": 2048}, "preview_height": {"const": 17}
      }
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "created_at", "finished_at", "options", "provenance", "decision", "board_tested", "accuracy_evaluated", "source", "width", "height", "radius", "threshold", "polarity", "component_count", "bbox_convention", "connectivity", "implementation", "min_area", "images", "native_wall_seconds", "stripes", "retained_input_cache_peak_bytes", "output_words_sha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^(run-[0-9a-f]{32}|replay-16k)$"},
        "status": {"const": "complete"},
        "created_at": {"type": "number", "minimum": 0},
        "finished_at": {"type": "number", "minimum": 0},
        "options": {"$ref": "#/$defs/options"},
        "provenance": {"enum": ["synthetic-native", "recorded-replay"]},
        "decision": {"const": "unknown"}, "board_tested": {"const": false},
        "accuracy_evaluated": {"const": false}, "source": {"const": "synthetic"},
        "width": {"const": 16384}, "height": {"const": 135},
        "radius": {"type": "integer", "minimum": 0, "maximum": 7},
        "threshold": {"type": "integer", "minimum": 1, "maximum": 255},
        "polarity": {"enum": ["both", "bright", "dark"]},
        "component_count": {"type": "integer", "minimum": 0},
        "bbox_convention": {"const": "half-open"}, "connectivity": {"const": 8},
        "implementation": {"const": "native C++ shared with FPGA IP"}, "min_area": {"const": 2},
        "images": {
          "type": "object", "additionalProperties": false, "required": ["corrected", "mask"],
          "properties": {"corrected": {"$ref": "#/$defs/image"}, "mask": {"$ref": "#/$defs/image"}}
        },
        "native_wall_seconds": {"type": "number", "minimum": 0},
        "stripes": {"type": "integer", "minimum": 1, "maximum": 135},
        "retained_input_cache_peak_bytes": {"type": "integer", "minimum": 0, "maximum": 8388608},
        "output_words_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "bbox", "polarity", "area", "peak", "signed_peak", "frame_id", "decision"],
      "properties": {
        "id": {"type": "string", "pattern": "^c[0-9]{6,}$"},
        "bbox": {"type": "array", "minItems": 4, "maxItems": 4,
          "prefixItems": [
            {"type": "integer", "minimum": 0, "maximum": 16383},
            {"type": "integer", "minimum": 0, "maximum": 134},
            {"type": "integer", "minimum": 1, "maximum": 16384},
            {"type": "integer", "minimum": 1, "maximum": 135}
          ]},
        "polarity": {"enum": ["bright", "dark"]},
        "area": {"type": "integer", "minimum": 2, "maximum": 2211840},
        "peak": {"type": "integer", "minimum": 1, "maximum": 255},
        "signed_peak": {"type": "integer", "minimum": -255, "maximum": 255, "not": {"const": 0}},
        "frame_id": {"oneOf": [
          {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
          {"type": "string", "pattern": "^[0-9]{1,20}$"}
        ]},
        "decision": {"const": "unknown"}
      }
    }
  }
}
